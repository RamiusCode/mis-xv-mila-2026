---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light only" />
    <link rel="icon" type="image/svg+xml" href="/Coronadorada.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Forzar modo claro y evitar dark mode del navegador */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden; /* ← Elimina scroll horizontal */
        color-scheme: light only;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden; /* ← Elimina scroll horizontal */
        background-image: url("/imagenes/fondolila.webp");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        color-scheme: light only;
        background-color: #ffffff;
      }

      main {
        background: transparent !important;
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <canvas id="particulas-fondo"></canvas>
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>

    <script>
      const canvas = document.getElementById("particulas-fondo") as HTMLCanvasElement;
      const ctx = canvas.getContext("2d")!;

      let W = window.innerWidth;
      let H = window.innerHeight;
      canvas.width = W;
      canvas.height = H;

      window.addEventListener("resize", () => {
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = W;
        canvas.height = H;
      });

      const TOTAL = 55;

      const particulas = Array.from({ length: TOTAL }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() * 4 + 2.5,
        opacidad: 0,
        opacidadMax: Math.random() * 0.35 + 0.45,
        fase: Math.random() * Math.PI * 2,
        velParpadeo: Math.random() * 0.01 + 0.004,
        velX: (Math.random() - 0.5) * 0.25,
        velY: (Math.random() - 0.5) * 0.15,
        faseDrift: Math.random() * Math.PI * 2,
        velDrift: Math.random() * 0.003 + 0.001,
      }));

      let frame = 0;

      function dibujar() {
        ctx.clearRect(0, 0, W, H);
        frame++;

        for (const p of particulas) {
          // Parpadeo natural
          p.opacidad = p.opacidadMax * (0.5 + 0.5 * Math.sin(frame * p.velParpadeo + p.fase));

          // Flotado suave ondulante
          p.x += p.velX + Math.sin(frame * p.velDrift + p.faseDrift) * 0.3;
          p.y += p.velY + Math.cos(frame * p.velDrift + p.faseDrift) * 0.2;

          // Rebotar en los bordes suavemente
          if (p.x < 0) p.x = W;
          if (p.x > W) p.x = 0;
          if (p.y < 0) p.y = H;
          if (p.y > H) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${p.opacidad})`;
          ctx.fill();
        }

        requestAnimationFrame(dibujar);
      }

      dibujar();
    </script>

    <style>
      #particulas-fondo {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      main {
        position: relative;
        z-index: 2;
      }
    </style>
  </body>
</html>

---
// Direccion.astro
---

<section class="py-8 px-4 relative">
  <div class="max-w-xl mx-auto text-center relative">
    <!-- TÍTULO DIRECCIÓN -->
    <div class="mb-2" id="titulo-direccion">
      <h2
        class="font-charm text-2xl md:text-3xl text-[#7B5BA6] font-bold tracking-wide"
      >
        RECEPCIÓN SOCIAL
      </h2>
    </div>
    <!-- 🏛️ ICONO DIRECCIÓN CON MARIPOSAS -->
    <div
      class="flex justify-center items-center gap-4 md:gap-6 mb-4"
      id="icono-direccion"
    >
      <!-- 🦋 MARIPOSA IZQUIERDA -->
      <div class="mariposa-flotante flex items-center" id="mariposa-dir-izq">
        <img
          src="/imagenes/velas.png"
          alt="Mariposa"
          class="w-16 h-auto object-contain scale-x-[-1]"
        />
      </div>

      <!-- ICONO CENTRAL -->
      <img
        src="/imagenes/direccion.png"
        alt="Icono de dirección"
        class="w-24 h-24 md:w-28 md:h-28 lg:w-32 lg:h-32 object-contain icono"
      />

      <!-- 🦋 MARIPOSA DERECHA -->
      <div class="mariposa-flotante flex items-center" id="mariposa-dir-der">
        <img
          src="/imagenes/velas.png"
          alt="Mariposa"
          class="w-16 h-auto object-contain"
        />
      </div>
    </div>

    <!-- INFORMACIÓN DE UBICACIÓN -->
    <div class="mb-2" id="info-direccion">
      <!-- Nombre del lugar -->
      <h3 class="font-charm text-2xl md:text-2xl text-[#C9A24D] font-bold mb-2">
        Utopía Club
      </h3>

      <!-- Dirección -->
      <p
        class="font-charm text-lg md:text-xl text-[#7B5BA6] leading-relaxed mb-3"
      >
        Urbanización El Pedregal <br />Calle 6 #102 <br />Zona Alto Calacoto
      </p>

      <!-- Hora -->
      <p class="font-charm text-2xl md:text-2xl text-[#7B5BA6] font-bold">
        Hora: 17:00
      </p>
    </div>

    <!-- BOTÓN VER UBICACIÓN - ROSADO SIMPLE -->
    <div class="flex justify-center" id="boton-ubicacion">
      <a
        href="https://maps.app.goo.gl/KWyKcLXNxA5QPyNy8"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-8 py-2 md:px-10 md:py-4 bg-[#7B5BA6] rounded-lg shadow-md hover:shadow-lg hover:bg-[#7B5BA6] transition-all duration-300"
      >
        <!-- Icono de ubicación -->
        <svg
          class="w-5 h-5 md:w-6 md:h-6 text-white"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>

        <!-- Texto -->
        <span class="font-charm text-lg md:text-xl text-white font-semibold">
          Ver Ubicación
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      // Estado inicial
      gsap.set("#icono-direccion", { opacity: 0, scale: 0.8 });
      gsap.set("#titulo-direccion", { opacity: 0, scale: 0.9 });
      gsap.set("#info-direccion", { opacity: 0, scale: 0.9 });
      gsap.set("#boton-ubicacion", { opacity: 0, scale: 0.9 });
      gsap.set("#mariposa-dir-izq", {
        opacity: 0,
        y: 50,
        scale: 0.85,
        filter: "brightness(0.3)",
      });
      gsap.set("#mariposa-dir-der", {
        opacity: 0,
        y: 50,
        scale: 0.85,
        filter: "brightness(0.3)",
      });

      // ✨ ANIMACIÓN SIMULTÁNEA - TODO AL MISMO TIEMPO
      ScrollTrigger.create({
        trigger: "#icono-direccion",
        start: "top 85%",
        end: "top 20%",
        onEnter: () => {
          const tl = gsap.timeline();

          // TODO aparece al mismo tiempo
          tl.to(
            "#icono-direccion, #mariposa-dir-izq, #mariposa-dir-der, #titulo-direccion, #info-direccion, #boton-ubicacion",
            {
              opacity: 1,
              duration: 1,
              ease: "power2.out",
            },
          )
            // Animaciones individuales (simultáneas)
            .to(
              "#icono-direccion",
              {
                scale: 1,
                duration: 1,
                ease: "back.out(1.5)",
              },
              "<",
            )
            .to(
              "#mariposa-dir-izq",
              {
                y: 0,
                scale: 1,
                filter: "brightness(1)",
                duration: 1.4,
                ease: "power2.out",
              },
              "<",
            )
            .to(
              "#mariposa-dir-der",
              {
                y: 0,
                scale: 1,
                filter: "brightness(1)",
                duration: 1.4,
                ease: "power2.out",
              },
              "<",
            )
            .to(
              "#titulo-direccion, #info-direccion, #boton-ubicacion",
              {
                scale: 1,
                duration: 1,
                ease: "back.out(1.2)",
              },
              "<",
            );

          // Parpadeo continuo simulando llama
          gsap.to("#mariposa-dir-izq", {
            scale: 1.04,
            filter: "brightness(1.15)",
            y: -3,
            duration: 0.9,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 0.5,
          });

          gsap.to("#mariposa-dir-der", {
            scale: 1.04,
            filter: "brightness(1.15)",
            y: -3,
            duration: 1.1,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 0.7,
          });
        },
        onLeaveBack: () => {
          // Salida simultánea
          const tl = gsap.timeline();

          tl.to(
            "#icono-direccion, #mariposa-dir-izq, #mariposa-dir-der, #titulo-direccion, #info-direccion, #boton-ubicacion",
            {
              opacity: 0,
              duration: 0.5,
              ease: "power2.in",
            },
          )
            .to(
              "#icono-direccion",
              {
                scale: 0.8,
                duration: 0.5,
                ease: "power2.in",
              },
              "<",
            )
            .to(
              "#mariposa-dir-izq",
              {
                y: 50,
                scale: 0.85,
                filter: "brightness(0.3)",
                duration: 0.5,
                ease: "power2.in",
              },
              "<",
            )
            .to(
              "#mariposa-dir-der",
              {
                y: 50,
                scale: 0.85,
                filter: "brightness(0.3)",
                duration: 0.5,
                ease: "power2.in",
              },
              "<",
            )
            .to(
              "#titulo-direccion, #info-direccion, #boton-ubicacion",
              {
                scale: 0.9,
                duration: 0.5,
                ease: "power2.in",
              },
              "<",
            );
        },
      });

      console.log("📍🦋 Sección de Dirección con mariposas inicializada");
    });
  }
</script>

<style>
  /* Asegurar que las mariposas tengan un movimiento fluido */
  .mariposa-flotante {
    will-change: transform;
    transition: all 0.3s ease;
  }

  /* Hover en las mariposas */
  .mariposa-flotante:hover {
    transform: scale(1.1) !important;
    filter: brightness(1.2);
  }

  /* Filtro dorado para #a27735 */
  .icono-dorado {
    filter: brightness(0) saturate(100%) invert(81%) sepia(18%) saturate(1253%)
      hue-rotate(228deg) brightness(98%) contrast(91%);
    transition:
      filter 0.3s ease,
      transform 0.3s ease;
  }
</style>
